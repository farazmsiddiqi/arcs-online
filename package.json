{
  "name": "arcs-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "test:browser": "node scripts/browser-check.mjs",
    "test:simulation": "node scripts/simulate.js",
    "verify:assets": "node scripts/verify-assets.mjs",
    "format": "prettier --write game server src tests scripts",
    "test:tools": "node scripts/tool-check.mjs",
    "test:ux": "node scripts/ux-check.mjs",
    "test:controls": "node scripts/controls-check.mjs",
    "test:learning": "node scripts/learning-check.mjs",
    "test:resources": "node scripts/resource-tray-check.mjs",
    "test:ux-states": "node scripts/ux-state-check.mjs",
    "test:ux-flows": "node scripts/ux-flow-check.mjs",
    "fixtures:ux": "node scripts/ux-fixtures.mjs",
    "test:player-table": "node scripts/player-table-check.mjs",
    "test:shared-board": "node scripts/shared-board-check.mjs",
    "test:timeouts": "node --test tests/timeout.test.js tests/timeout-server.test.js",
    "test:timeout-simulations": "node scripts/timeout-simulations.mjs",
    "pretest": "npm run verify:assets",
    "prebuild": "npm run verify:assets",
    "predev": "npm run verify:assets",
    "test:ux-sweep": "node scripts/ux-sweep.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@playwright/test": "^1.55.1",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.9",
    "vite": "^7.1.7"
  },
  "license": "MIT"
}
